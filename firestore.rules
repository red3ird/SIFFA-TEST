rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Colección /siteImages: imágenes y fotografías de la web administradas institucionalmente
    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Colección /users: perfiles institucionales
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Colección /professionals: consulta y actualización de legajos y fotografías
    match /professionals/{professionalId} {
      allow read: if true;
      allow write: if true;
    }

    // Colecciones sensibles: Credenciales, Autorizaciones penitenciarias, Accesos y Auditoría
    // REGLA CRÍTICA DE SEGURIDAD: NUNCA legibles directamente desde el cliente.
    // Toda consulta pasa exclusivamente a través de los endpoints autenticados del backend (/api/verify/:qrToken, /api/me/credential).
    match /credentials/{credentialId} {
      allow read, write: if false;
    }

    match /authorizations/{authorizationId} {
      allow read, write: if false;
    }

    match /accessEvents/{eventId} {
      allow read, write: if false;
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    // Bloqueo por defecto para cualquier otra ruta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
